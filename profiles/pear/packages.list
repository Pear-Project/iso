live-boot
squashfs-tools
# NVIDIA Drivers (only included with --nvidia; see build-iso.sh). Kernel
# headers to build the DKMS module against come from the linux-headers-*-pearos
# entry (PROFILE_REPO_PACKAGES in packages.sh, version filled in dynamically
# by repo.sh) instead of linux-headers-amd64, since the profile's actual
# kernel is the custom pearOS one, not linux-image-amd64.
nvidia-driver
# Broadcom Drivers
broadcom-sta-dkms
dkms
# Firmware Packages for Hardware/Graphics Compatibility
firmware-linux
firmware-misc-nonfree
# Additional Wi-Fi/Bluetooth firmware for the live boot (same ones Calamares installs)
firmware-iwlwifi
firmware-realtek
firmware-atheros
firmware-brcm80211
firmware-amd-graphics
# Hardware video acceleration (VA-API) and Mesa Vulkan -- Wayland uses
# DRM/KMS + Mesa directly, no xserver-xorg-video-* drivers needed
mesa-va-drivers
mesa-vulkan-drivers
intel-media-va-driver-non-free
